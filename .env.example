# Formulaire de contact (upload de fichiers) -- Vercel Blob
# Dashboard Vercel -> Storage -> ton Blob store -> onglet ".env.local"
BLOB_READ_WRITE_TOKEN=
# Meme page -- verifie la signature du webhook onUploadCompleted (cle publique, pas un secret)
BLOB_WEBHOOK_PUBLIC_KEY=

# Emails transactionnels (contact + devis) -- Brevo (ex-Sendinblue)
# Dashboard Brevo -> SMTP & API -> API Keys
BREVO_API_KEY=
BREVO_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=

# Funnel configurateur -> devis
# Dashboard Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
